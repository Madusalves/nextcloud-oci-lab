# =============================================================================
# Modelo de variaveis de ambiente — VALORES FICTICIOS
#
# Como usar:
#   cp .env.example oci-bucket/.env      (e preencha com os dados da OCI)
#   cp .env.example local-rustfs/.env    (e preencha com os valores "LOCAL")
#
# O docker compose le o .env da MESMA pasta do docker-compose.yml.
# Os arquivos .env reais sao ignorados pelo git (ver .gitignore).
#
# Atencao: o compose interpreta "$" como variavel. Evite "$" nas senhas
# ou coloque o valor entre aspas simples: SENHA='abc$123'
# =============================================================================

# -----------------------------------------------------------------------------
# Nextcloud — instalacao automatica
# So ocorre se ADMIN_USER + ADMIN_PASSWORD + todas as POSTGRES_* estiverem
# definidas. Sem elas, o Nextcloud abre o assistente web de instalacao.
# -----------------------------------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=troque-esta-senha-admin

# Lista SEPARADA POR ESPACO dos hosts pelos quais o Nextcloud sera acessado.
# Local: localhost. Na VM da OCI: o IP publico ou o dominio da VM.
NEXTCLOUD_TRUSTED_DOMAINS="localhost 127.0.0.1"

# Porta do host mapeada para a porta 80 do container.
NEXTCLOUD_HTTP_PORT=8080

# -----------------------------------------------------------------------------
# PostgreSQL
# Os mesmos nomes servem para a imagem do postgres (cria o banco/usuario)
# e para a imagem do Nextcloud (se conecta a ele).
# POSTGRES_HOST fica fixo no docker-compose.yml (nome do servico "db").
# -----------------------------------------------------------------------------
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=troque-esta-senha-db

# -----------------------------------------------------------------------------
# Redis (cache distribuido, locks de arquivo e sessoes PHP)
# A mesma senha configura o servidor Redis e o cliente no Nextcloud.
# REDIS_HOST fica fixo no docker-compose.yml (nome do servico "redis").
# -----------------------------------------------------------------------------
REDIS_HOST_PASSWORD=troque-esta-senha-redis

# -----------------------------------------------------------------------------
# Object Storage S3 (primary storage)
#
# Exemplo OCI:
#   HOST     = <namespace>.compat.objectstorage.<regiao>.oraclecloud.com
#   PORT     = 443 / SSL = true
#   REGION   = codigo da regiao (ex.: sa-saopaulo-1)
#   KEY/SECRET = Customer Secret Key (Profile > Customer secret keys)
#
# Exemplo LOCAL (RustFS):
#   HOST = rustfs (nome do servico no compose) / PORT = 9000 / SSL = false
#   KEY/SECRET = qualquer valor; o compose usa os mesmos como credencial
#   do proprio RustFS
# -----------------------------------------------------------------------------
OBJECTSTORE_S3_HOST=meunamespace.compat.objectstorage.sa-saopaulo-1.oraclecloud.com
OBJECTSTORE_S3_PORT=443
OBJECTSTORE_S3_SSL=true
OBJECTSTORE_S3_REGION=sa-saopaulo-1
OBJECTSTORE_S3_BUCKET=nextcloud-teste

# Requisicoes no formato https://host/bucket (em vez de https://bucket.host)
OBJECTSTORE_S3_USEPATH_STYLE=true

# Padrao da imagem e "true". OCI: false (bucket ja existe).
# LOCAL: pode ser true para o Nextcloud criar o bucket no RustFS.
OBJECTSTORE_S3_AUTOCREATE=false

OBJECTSTORE_S3_KEY=EXEMPLO0ACCESS0KEY0000000000000000000000
OBJECTSTORE_S3_SECRET=EXEMPLO0SECRET0KEY00000000000000000000000
